# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Pick ONE provider for a measurement series so results stay comparable (see docs/PROVIDERS.md).

# --- Mistral (free "Experiment" plan: no card, phone verification) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_MIN_INTERVAL=1.1      # seconds between requests (free tier: 1 request/second)

# --- Groq ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Cerebras (may require a payment method) ---
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=

# Use exactly these providers, in this order (prevents trying an exhausted provider first):
LLM_PROVIDERS=mistral

# --- Stage 15 notification and post-mortem publishing ---
# Nothing below is used unless you pass --live (or --report-live). Without it, pages go to REPORT_DIR/wiki and Slack
# messages to REPORT_DIR/slack-outbox.jsonl.
# REPORT_DIR=.cache/reports
# SLACK_WEBHOOK_URL=                 # https://hooks.slack.com/services/... (a secret: never paste it in chat or logs)
# SLACK_MENTION_ON_HIGH=<!here>      # optional; only <!here>, <!channel>, <@Uxxxx> or <!subteam^Sxxxx>
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=              # an Atlassian API token (a secret)
# CONFLUENCE_SPACE=ENG
# CONFLUENCE_PARENT_ID=              # optional parent page id

# --- Stage 13 MCP: no settings; servers are started by the harness (--toolbox mcp) or by hand ---

# --- Stage 12 episodic memory ---
# EPISODE_MEMORY_DIR=.cache/episodes   # where episodes.jsonl is kept (never inside src/)

# --- Stage 10 retrieval ---
# EMBEDDER=hashing            # or st:BAAI/bge-small-en-v1.5 (needs: pip install -e ".[ml]")
# VECTOR_STORE=numpy          # or qdrant
# QDRANT_URL=                 # empty = local in-memory Qdrant
# EMBED_CACHE_DIR=.cache/embeddings
# RERANKER=overlap             # or ce:cross-encoder/ms-marco-MiniLM-L-6-v2 (needs: pip install -e ".[ml]")
# RERANK_CACHE_DIR=.cache/rerank
