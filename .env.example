# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Pick ONE provider for a measurement series so results stay comparable (see docs/PROVIDERS.md).

# --- Mistral (free "Experiment" plan: no card, phone verification) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_MIN_INTERVAL=1.1      # seconds between requests (free tier: 1 request/second)

# --- Groq ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Cerebras (may require a payment method) ---
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=

# Use exactly these providers, in this order (prevents trying an exhausted provider first):
LLM_PROVIDERS=mistral

# --- Stage 12 episodic memory ---
# EPISODE_MEMORY_DIR=.cache/episodes   # where episodes.jsonl is kept (never inside src/)

# --- Stage 10 retrieval ---
# EMBEDDER=hashing            # or st:BAAI/bge-small-en-v1.5 (needs: pip install -e ".[ml]")
# VECTOR_STORE=numpy          # or qdrant
# QDRANT_URL=                 # empty = local in-memory Qdrant
# EMBED_CACHE_DIR=.cache/embeddings
# RERANKER=overlap             # or ce:cross-encoder/ms-marco-MiniLM-L-6-v2 (needs: pip install -e ".[ml]")
# RERANK_CACHE_DIR=.cache/rerank
